# Application
APP_NAME=loan-service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
API_KEY_HEADER=X-API-Key
API_KEY=your-api-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loan_service
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# Idempotency
IDEMPOTENCY_KEY_HEADER=Idempotency-Key
IDEMPOTENCY_TTL_SECONDS=86400

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# External Services
ENTITY_SERVICE_URL=http://localhost:8001
DOCUMENT_SERVICE_URL=http://localhost:8002
AUTHZ_SERVICE_URL=http://localhost:8003
UTILS_SERVICE_URL=http://localhost:8004

# Service Timeouts (seconds)
SERVICE_TIMEOUT=30
SERVICE_MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
